# 本番（compose.prod.yaml）用の環境変数の見本。EC2 上で .env.prod にコピーして値を入れる
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod は Git に入れない（.gitignore 済み）。
#
# パスワードと JWT_SECRET は、必ず推測されない強いランダム値にすること。例：
#   openssl rand -hex 24      （DB のパスワード。URL に入れるので記号を含まない hex にする）
#   openssl rand -base64 48   （JWT_SECRET。32文字以上）
# 一度 DB を作ったあとに DB のパスワードを変えても、DB 側のパスワードは変わらない（docs/deploy.md 参照）

# ブラウザから開く URL（http://<EC2 のパブリック IP>）。独自ドメイン・HTTPS にしたら https://<ドメイン> に変える
PUBLIC_ORIGIN=http://203.0.113.10

# frontend を公開するポート
HTTP_PORT=80

# Cookie に Secure 属性を付けるか。HTTPS なしの間は false（true にするとログインできない）。HTTPS にしたら true
COOKIE_SECURE=false

# アップロードした画像の URL の先頭。frontend の /images/* が learning-service に転送するので、通常は /images のまま
IMAGE_BASE_URL=/images

# ログイン用トークンの署名の鍵（user-service と learning-service で共通）
JWT_SECRET=change_me

# users-db（user-service 用 MySQL）
USERS_DB_PASSWORD=change_me
USERS_ROOT_PASSWORD=change_me

# learning-db（learning-service 用 MySQL）
LEARNING_DB_PASSWORD=change_me
LEARNING_ROOT_PASSWORD=change_me
